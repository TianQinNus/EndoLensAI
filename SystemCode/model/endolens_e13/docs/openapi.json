  "components": {
    "schemas": {
      "AnalysisInput": {
        "properties": {
          "video_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Video Id"
          },
          "sampling_mode": {
            "type": "string",
            "enum": [
              "interval",
              "every_frame"
            ],
            "title": "Sampling Mode",
            "default": "interval"
          },
          "interval_seconds": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 900.0,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval Seconds",
            "default": 1.0
          },
          "model_version": {
            "type": "string",
            "const": "e13-r50-joint-r94-r4-region080-v2",
            "title": "Model Version",
            "default": "e13-r50-joint-r94-r4-region080-v2"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "video_id"
        ],
        "title": "AnalysisInput"
      },
      "Body_review_api_v1_frames__frame_id__review_put": {
        "properties": {
          "edited_mask": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Edited Mask"
          },
          "base_revision_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Revision Id"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "reviewed",
              "rejected"
            ],
            "title": "Review Status",
            "default": "reviewed"
          },
          "notes": {
            "type": "string",
            "title": "Notes",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "edited_mask"
        ],
        "title": "Body_review_api_v1_frames__frame_id__review_put"
      },
      "Body_upload_api_v1_videos_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_videos_post"
      },
      "ExportInput": {
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json"
            ],
            "title": "Format",
            "default": "csv"
          },
          "include_reviewed_masks": {
            "type": "boolean",
            "title": "Include Reviewed Masks",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExportInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
