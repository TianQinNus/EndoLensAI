# Uvicorn reads these variables before importing backend.main.
# The endolens conda environment can store them persistently; see README.md.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Backend runtime configuration.
ENDO_DEVICE=auto
ENDO_STORAGE_DIR=runtime_data
ENDO_MIN_REGION_AREA_RATIO=0
ENDO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
